@page "/categorias"

<h3>Categorias</h3>
<div class="row">
    <div class="col-md-4">
        <EditForm Model="nova" OnValidSubmit="AdicionarCategoria" FormName="formCategoria">
            <DataAnnotationsValidator />
            <div class="card card-body">
                <label class="form-label">Nome</label>
                <InputText class="form-control" @bind-Value="nova.Nome" />
                <ValidationMessage For="() => nova.Nome" class="text-danger" />

                <label class="form-label">Quantidade</label>
                <InputNumber class="form-control" @bind-Value="nova.Quantidade" />
                <ValidationMessage For="() => nova.Quantidade" class="text-danger" />

                <button type="submit" class="btn btn-primary mt-3">Adicionar</button>
            </div>
        </EditForm>
    </div>
    <div class="col-md-8">
        @if (categorias.Count == 0)
        {
            <p class="text-muted">Nenhuma categoria cadastrada</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Quantidade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in categorias)
                    {
                        <tr>
                            <td>@c.Nome</td>
                            <td>@c.Quantidade</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private Categoria nova = new();
    private List<Categoria> categorias = new();

    private void AdicionarCategoria()
    {
        categorias.Add(nova);
        nova = new Categoria();
    }
}